{
  "name": "three-industrial-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Industrial park 3D visualization demo: Three.js + Vue3 + TS + Vite, GitHub Pages ready",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "echarts": "^5.5.1",
    "pinia": "^4.1.0",
    "three": "^0.169.0",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.6"
  }
}
